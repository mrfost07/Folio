<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <FolioNativeTestPlatform Condition="'$(Platform)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</FolioNativeTestPlatform>
    <FolioNativeTestPlatform Condition="'$(FolioNativeTestPlatform)' == ''">x64</FolioNativeTestPlatform>
    <FolioRustCrtLinkage Condition="'$(FolioRustCrtLinkage)' == ''">Static</FolioRustCrtLinkage>
    <FolioNativeTestIntermediateDir>$(MSBuildProjectDirectory)\obj\rust-native\$(Configuration)\$(Platform)\$(RuntimeIdentifier)\$(FolioRustCrtLinkage)</FolioNativeTestIntermediateDir>
    <FolioNativeTestCargoTargetDir>$(FolioNativeTestIntermediateDir)\cargo-target</FolioNativeTestCargoTargetDir>
    <FolioNativeTestDll>$(FolioNativeTestIntermediateDir)\folio_native.dll</FolioNativeTestDll>
    <FolioNativeTestPdb>$(FolioNativeTestIntermediateDir)\folio_native.pdb</FolioNativeTestPdb>
  </PropertyGroup>

  <ItemGroup>
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\rust-toolchain.toml" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.toml" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.lock" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\folio-native\Cargo.toml" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\folio-native\src\**\*" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\include\folio_native.h" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\native-pe-contract.ps1" />
    <FolioNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\rust-arm64-msvc-environment.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Folio\Folio.csproj" />
    <ProjectReference Include="..\..\src\Folio.Updater\Folio.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Folio.Platform" />
  </ItemGroup>

  <Target
    Name="BuildFolioNativeTestModule"
    BeforeTargets="CoreCompile"
    Inputs="@(FolioNativeTestInput)"
    Outputs="$(FolioNativeTestDll);$(FolioNativeTestPdb)">
    <Error
      Condition="'$(FolioRustCrtLinkage)' != 'Dynamic' and '$(FolioRustCrtLinkage)' != 'Static'"
      Text="Folio test Rust CRT linkage must be Dynamic or Static." />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1&quot; -Platform $(FolioNativeTestPlatform) -Configuration $(Configuration) -CrtLinkage $(FolioRustCrtLinkage) -OutputDirectory &quot;$(FolioNativeTestIntermediateDir)&quot; -CargoTargetDirectory &quot;$(FolioNativeTestCargoTargetDir)&quot;" />
  </Target>

  <Target
    Name="CopyFolioNativeTestModule"
    AfterTargets="Build"
    DependsOnTargets="BuildFolioNativeTestModule">
    <Copy
      SourceFiles="$(FolioNativeTestDll);$(FolioNativeTestPdb)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
